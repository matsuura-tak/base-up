{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "appName": "LOGIC ARCADE",
    "feature": "001-arcade-core",
    "updatedAt": "2026-11-12",
    "principles": [
      "B-3: 4/8/12/16/24/32px spacing grid only",
      "B-4: Single system sans-serif family with tabular-nums, max 4 type steps, no light/thin weights",
      "B-5: Semantic color tokens only; WCAG 2.2 AA verified across light, dark, and high-contrast modes"
    ]
  },
  "color": {
    "surface": {
      "canvas": {
        "description": "Page root background",
        "light": "#F4F7FB",
        "dark": "#090D16",
        "highContrastLight": "#FFFFFF",
        "highContrastDark": "#000000",
        "forcedColors": "Canvas"
      },
      "panel": {
        "description": "Card, slot, debug log, and explanation container surface",
        "light": "#FFFFFF",
        "dark": "#111827",
        "highContrastLight": "#FFFFFF",
        "highContrastDark": "#000000",
        "forcedColors": "Canvas"
      },
      "elevated": {
        "description": "Header bar, active slot highlight surface, and secondary control background",
        "light": "#EBF0F7",
        "dark": "#1A2438",
        "highContrastLight": "#F5F5F5",
        "highContrastDark": "#0A0A0A",
        "forcedColors": "ButtonFace"
      },
      "stage": {
        "description": "Simulation Canvas and SVG radar chart instrument backdrop",
        "light": "#F8FAFC",
        "dark": "#0D1424",
        "highContrastLight": "#FFFFFF",
        "highContrastDark": "#000000",
        "forcedColors": "Canvas"
      },
      "disabled": {
        "description": "Disabled button surface (paired with slot guidance text)",
        "light": "#E2E8F0",
        "dark": "#1E293B",
        "highContrastLight": "#EEEEEE",
        "highContrastDark": "#1A1A1A",
        "forcedColors": "ButtonFace"
      }
    },
    "text": {
      "primary": {
        "description": "Headings, body copy, numeric telemetry, and button labels on neutral surfaces",
        "light": "#0F172A",
        "dark": "#F1F5F9",
        "highContrastLight": "#000000",
        "highContrastDark": "#FFFFFF",
        "forcedColors": "CanvasText"
      },
      "secondary": {
        "description": "Supporting labels, units, stage hints, and metadata",
        "light": "#334155",
        "dark": "#CBD5E1",
        "highContrastLight": "#141414",
        "highContrastDark": "#EFEFEF",
        "forcedColors": "CanvasText"
      },
      "onAction": {
        "description": "Foreground label on primary action button",
        "light": "#FFFFFF",
        "dark": "#06121E",
        "highContrastLight": "#FFFFFF",
        "highContrastDark": "#000000",
        "forcedColors": "HighlightText"
      },
      "disabled": {
        "description": "Foreground label on disabled controls (exempt under WCAG 1.4.3; always accompanied by active guidance text)",
        "light": "#64748B",
        "dark": "#94A3B8",
        "highContrastLight": "#555555",
        "highContrastDark": "#A6A6A6",
        "forcedColors": "GrayText"
      }
    },
    "action": {
      "primary": {
        "description": "Single primary CTA fill per screen and active selection accent",
        "light": "#0055D4",
        "dark": "#22D3EE",
        "highContrastLight": "#003399",
        "highContrastDark": "#00FFFF",
        "forcedColors": "Highlight"
      },
      "primaryHover": {
        "description": "Hover and active press state for primary CTA",
        "light": "#003FA3",
        "dark": "#67E8F9",
        "highContrastLight": "#001F66",
        "highContrastDark": "#80FFFF",
        "forcedColors": "Highlight"
      }
    },
    "status": {
      "success": {
        "description": "STAGE CLEAR, PERFECT ORDER, cleared stage badge, S+/S rank",
        "light": "#006B54",
        "dark": "#34D399",
        "highContrastLight": "#004D3B",
        "highContrastDark": "#5CFFB8",
        "forcedColors": "CanvasText"
      },
      "successBg": {
        "description": "Subtle tint backdrop for success status banner/badge",
        "light": "#E6F7F2",
        "dark": "#082922",
        "highContrastLight": "#FFFFFF",
        "highContrastDark": "#000000",
        "forcedColors": "Canvas"
      },
      "info": {
        "description": "GOOD RANGE, active step signal pulse, A/B rank, copy toast",
        "light": "#0055D4",
        "dark": "#38BDF8",
        "highContrastLight": "#003399",
        "highContrastDark": "#66D9FF",
        "forcedColors": "Highlight"
      },
      "infoBg": {
        "description": "Subtle tint backdrop for info status banner/badge",
        "light": "#E8F1FF",
        "dark": "#0A2239",
        "highContrastLight": "#FFFFFF",
        "highContrastDark": "#000000",
        "forcedColors": "Canvas"
      },
      "warning": {
        "description": "Side-effect heat gauge caution, OVERKILL, storage fallback notice, C/UNRANKED badge",
        "light": "#8A4B00",
        "dark": "#FBBF24",
        "highContrastLight": "#663600",
        "highContrastDark": "#FFD633",
        "forcedColors": "CanvasText"
      },
      "warningBg": {
        "description": "Subtle tint backdrop for warning notice/badge",
        "light": "#FFF4E5",
        "dark": "#2B1F06",
        "highContrastLight": "#FFFFFF",
        "highContrastDark": "#000000",
        "forcedColors": "Canvas"
      },
      "danger": {
        "description": "CRASHED, FAILED, UNDERESTIMATE, trap card callout, clipboard error notice",
        "light": "#B3124F",
        "dark": "#FB7185",
        "highContrastLight": "#8C0036",
        "highContrastDark": "#FF80A6",
        "forcedColors": "CanvasText"
      },
      "dangerBg": {
        "description": "Subtle tint backdrop for crash/error debug log and trap alert",
        "light": "#FDECF2",
        "dark": "#310E1B",
        "highContrastLight": "#FFFFFF",
        "highContrastDark": "#000000",
        "forcedColors": "Canvas"
      }
    },
    "border": {
      "default": {
        "description": "Interactive button, card, slot, and panel border (>= 3.0:1 against all surfaces)",
        "light": "#5B6B82",
        "dark": "#7C8EA6",
        "highContrastLight": "#000000",
        "highContrastDark": "#FFFFFF",
        "forcedColors": "ButtonText"
      },
      "disabled": {
        "description": "Dashed border for disabled buttons",
        "light": "#94A3B8",
        "dark": "#475569",
        "highContrastLight": "#666666",
        "highContrastDark": "#808080",
        "forcedColors": "GrayText"
      }
    },
    "focus": {
      "ring": {
        "description": "2px solid keyboard focus indicator with 2px offset (>= 7.24:1 across all modes)",
        "light": "#0044AA",
        "dark": "#38BDF8",
        "highContrastLight": "#002277",
        "highContrastDark": "#FFFF00",
        "forcedColors": "Highlight"
      }
    },
    "chart": {
      "grid": {
        "description": "Pentagon radar chart grid and simulation gauge frame (>= 4.55:1)",
        "light": "#64748B",
        "dark": "#7C8EA6",
        "highContrastLight": "#262626",
        "highContrastDark": "#CCCCCC",
        "forcedColors": "CanvasText"
      },
      "polygonStroke": {
        "description": "Radar chart score polygon 2.5px stroke and vertex markers (>= 6.18:1)",
        "light": "#0055D4",
        "dark": "#22D3EE",
        "highContrastLight": "#003399",
        "highContrastDark": "#00FFFF",
        "forcedColors": "Highlight"
      },
      "polygonFill": {
        "description": "Decorative translucent fill inside score polygon (meaning carried by stroke, vertices, and DOM score text)",
        "light": "rgba(0, 85, 212, 0.16)",
        "dark": "rgba(34, 211, 238, 0.20)",
        "highContrastLight": "rgba(0, 51, 153, 0.12)",
        "highContrastDark": "rgba(0, 255, 255, 0.18)",
        "forcedColors": "transparent"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "base": "system-ui, -apple-system, BlinkMacSystemFont, \"Hiragino Sans\", \"Hiragino Kaku Gothic ProN\", \"Noto Sans JP\", \"Yu Gothic UI\", sans-serif"
    },
    "numericVariant": "tabular-nums",
    "scale": {
      "display": {
        "size": "1.75rem",
        "pxEquivalent": 28,
        "lineHeight": 1.25,
        "weight": 700,
        "usage": "Page h1 title, overall rank emblem (S+..C / UNRANKED), major result banner"
      },
      "heading": {
        "size": "1.25rem",
        "pxEquivalent": 20,
        "lineHeight": 1.35,
        "weight": 700,
        "usage": "Section h2/h3 headings, stage question prompt, score values"
      },
      "body": {
        "size": "1rem",
        "pxEquivalent": 16,
        "lineHeight": 1.55,
        "weightRegular": 400,
        "weightStrong": 600,
        "usage": "Primary UI controls, module/card descriptions, debug logs, Fermi explanations"
      },
      "caption": {
        "size": "0.875rem",
        "pxEquivalent": 14,
        "lineHeight": 1.45,
        "weight": 600,
        "usage": "Slot step badges (STEP 1..3, ACT 1..3), attribute tags, header utility buttons"
      }
    },
    "measure": {
      "proseMaxCh": "38em"
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px"
  },
  "sizing": {
    "containerMax": "1200px",
    "targetMin": "24px",
    "targetMobileRecommended": "44px",
    "borderWidthDefault": "1.5px",
    "borderWidthActive": "2px",
    "focusRingWidth": "2px",
    "focusRingOffset": "2px",
    "radiusSm": "4px",
    "radiusMd": "8px"
  },
  "breakpoints": {
    "mobileMin": "320px",
    "tablet": "768px",
    "desktop": "1280px"
  },
  "motion": {
    "simulationRunMaxMs": 2400,
    "simulationRunCeilingMs": 3000,
    "simulationStepMs": 450,
    "simulationReducedMotionMaxMs": 450,
    "simulationReducedMotionCeilingMs": 1000,
    "resetMaxMs": 100,
    "resetCeilingMs": 200,
    "toastMinVisibleMs": 3000,
    "shakeAmplitudeDefaultPx": 4,
    "shakeAmplitudeReducedMotionPx": 0,
    "maxFlashesPerSecond": 2
  }
}
